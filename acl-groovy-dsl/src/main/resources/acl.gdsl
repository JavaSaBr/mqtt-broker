contributor(context(scope: scriptScope())) {

  method name: 'allowPublish',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder',
      params: [config: 'Closure<javasabr.mqtt.service.acl.NewAclRulesBuilder.PublishRuleBuilder>'],
      delegateType: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.PublishRuleBuilder',
      doc: 'Define a rule'
  method name: 'denyPublish',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder',
      params: [config: 'Closure<javasabr.mqtt.service.acl.NewAclRulesBuilder.PublishRuleBuilder>'],
      delegateType: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.PublishRuleBuilder',
      doc: 'Define a rule'
  method name: 'allowSubscribe',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder',
      params: [config: 'Closure<javasabr.mqtt.service.acl.NewAclRulesBuilder.SubscribeRuleBuilder>'],
      delegateType: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.SubscribeRuleBuilder',
      doc: 'Define a rule'
  method name: 'denySubscribe',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder',
      params: [config: 'Closure<javasabr.mqtt.service.acl.NewAclRulesBuilder.SubscribeRuleBuilder>'],
      delegateType: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.SubscribeRuleBuilder',
      doc: 'Define a rule'

  method name: 'topicName',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.PublishRuleBuilder',
      params: [string: 'String...'],
      doc: 'Set topics for the rule'
  method name: 'topicFilter',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.SubscribeRuleBuilder',
      params: [string: 'String...'],
      doc: 'Set topics for the rule'
  method name: 'allClients',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.ClientsBuilder',
      params: [config: 'Closure'],
      delegateType: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.ClientsBuilder',
      doc: 'Define clients filter for this rule'
  method name: 'anyClient',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.ClientsBuilder',
      params: [config: 'Closure'],
      delegateType: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.ClientsBuilder',
      doc: 'Define clients filter for this rule'

  method name: 'username',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.ClientsBuilder',
      params: [string: 'javasabr.mqtt.model.acl.ClientComparator...'],
      doc: 'Filter by username'
  method name: 'clientId',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.ClientsBuilder',
      params: [string: 'javasabr.mqtt.model.acl.ClientComparator...'],
      doc: 'Filter by clientId'
  method name: 'clientAttr',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.ClientsBuilder',
      params: [string: 'Map<String, String>'],
      doc: 'Filter by client attributes'
  method name: 'ipaddr',
      type: 'javasabr.mqtt.service.acl.NewAclRulesBuilder.ClientsBuilder',
      params: [string: 'javasabr.mqtt.model.acl.ClientComparator...'],
      doc: 'Filter by IP address'

  method name: 'eq',
      type: 'javasabr.mqtt.model.acl.ClientComparator',
      params: [string: 'String'],
      doc: 'Checks strict equality of strings'
  method name: 'regex',
      type: 'javasabr.mqtt.model.acl.ClientComparator',
      params: [string: 'String'],
      doc: 'Checks strings for Regex matching'
}
