contributor(context(scope: scriptScope())) {

  def insideAllowPublish = enclosingCall("allowPublish")
  def insideDenyPublish = enclosingCall("denyPublish")

  def insideAllowSubscribe = enclosingCall("allowSubscribe")
  def insideDenySubscribe = enclosingCall("denySubscribe")

  def insideUsers = enclosingCall("users")
  def insideTopics = enclosingCall("topics")
  def insideRootElement = insideAllowPublish || insideDenyPublish || insideAllowSubscribe || insideDenySubscribe

  if (!insideRootElement) {
    method name: 'allowPublish',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.AclRulesBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.PublishRuleBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.PublishRuleBuilder',
        doc: 'Define Access Control List rule'
    method name: 'denyPublish',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.AclRulesBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.PublishRuleBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.PublishRuleBuilder',
        doc: 'Define Access Control List rule'
    method name: 'allowSubscribe',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.AclRulesBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.SubscribeRuleBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.SubscribeRuleBuilder',
        doc: 'Define Access Control List rule'
    method name: 'denySubscribe',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.AclRulesBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.SubscribeRuleBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.SubscribeRuleBuilder',
        doc: 'Define Access Control List rule'
  }
  
  if (insideRootElement && !insideUsers && !insideTopics) {
    method name: 'users',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.UsersBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        doc: 'Define user conditions to apply this rule'
  }

  if (insideRootElement && !insideUsers && !insideTopics) {
    method name: 'topics',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.TopicsBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        doc: 'Define topic matchers to apply this rule'
  }

  if (insideTopics) {
    method name: 'match',
        type: 'javasabr.mqtt.acl.engine.model.matcher.TopicFilterMatcher',
        params: [string: 'String'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.TopicsBuilder',
        doc: 'Match incoming topic by topic filter'
    method name: 'eq',
        type: 'javasabr.mqtt.acl.engine.model.matcher.TopicNameMatcher',
        params: [string: 'String'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.TopicsBuilder',
        doc: 'Match incoming topic by topic filter'
  }


  if ((insideAllowSubscribe || insideDenySubscribe)
      && !enclosingCall("allOf") && !enclosingCall("anyOf")) {
    method name: 'topicFilter',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.SubscribeRuleBuilder',
        params: [string: 'javasabr.mqtt.model.acl.matcher.ValueMatcher<String>...'],
        doc: 'Set of topic filters matching by rule'
    method name: 'match',
        type: 'javasabr.mqtt.model.acl.matcher.TopicFilterMatcher',
        params: [string: 'String'],
        doc: 'Match incoming topic by topic filter'
  }

  if (insideAllowPublish || insideDenyPublish
      || insideAllowSubscribe || insideDenySubscribe) {
    method name: 'eq',
        type: 'javasabr.mqtt.model.acl.matcher.EqualsMatcher',
        params: [string: 'String'],
        doc: 'Match incoming value by strict equality'
  }

  if (insideAllowPublish || insideDenyPublish
      || insideAllowSubscribe || insideDenySubscribe) {
    method name: 'startWith',
        type: 'javasabr.mqtt.model.acl.matcher.StartWithMatcher',
        params: [string: 'String'],
        doc: 'Match incoming value by string prefix'
  }

  if (enclosingCall("allOf") || enclosingCall("anyOf")) {
    method name: 'regex',
        type: 'javasabr.mqtt.model.acl.matcher.RegexMatcher',
        params: [string: 'String'],
        doc: 'Match incoming value by Regular Expression'
  }

  if (!enclosingCall("allOf")
      && !enclosingCall("anyOf")
      && (insideAllowPublish
      || insideDenyPublish
      || insideAllowSubscribe
      || insideDenySubscribe)) {
    method name: 'allOf',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        doc: 'All of conditions match an incoming client'
    method name: 'anyOf',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        doc: 'At least one condition matches an incoming client'
    method name: 'anyOf',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        params: [:],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.RuleBuilder',
        doc: 'Match any incoming client'
  }

  if (!enclosingCall("allOf") && enclosingCall("anyOf")) {
    method name: 'allOf',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.AllOfBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder',
        doc: 'All of conditions match an incoming client'
    method name: 'anyOf',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.AnyOfBuilder',
        params: [config: 'Closure<javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder>'],
        delegateType: 'javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder',
        doc: 'At least one condition matches an incoming client'
  }

  if (enclosingCall("allOf")) {
    method name: 'userName',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder',
        params: [string: 'javasabr.mqtt.model.acl.matcher.ValueMatcher<String>'],
        doc: 'Match by username'
    method name: 'clientId',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder',
        params: [string: 'javasabr.mqtt.model.acl.matcher.ValueMatcher<String>'],
        doc: 'Match by clientId'
    method name: 'ipAddress',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder',
        params: [string: 'javasabr.mqtt.model.acl.matcher.ValueMatcher<String>'],
        doc: 'Match by IP address'
  }
  if (enclosingCall("anyOf") && !enclosingCall("allOf")) {
    method name: 'userName',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder',
        params: [string: 'javasabr.mqtt.model.acl.matcher.ValueMatcher<String>...'],
        doc: 'Match by username'
    method name: 'clientId',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder',
        params: [string: 'javasabr.mqtt.model.acl.matcher.ValueMatcher<String>...'],
        doc: 'Match by clientId'
    method name: 'ipAddress',
        type: 'javasabr.mqtt.acl.groovy.dsl.builder.ConditionBuilder',
        params: [string: 'javasabr.mqtt.model.acl.matcher.ValueMatcher<String>...'],
        doc: 'Match by IP address'
  }

  method name: 'anyone',
      type: 'javasabr.mqtt.model.acl.matcher.AnyValueMatcher',
      params: [:],
      doc: 'Match any incoming value'
}
