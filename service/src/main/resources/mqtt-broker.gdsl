contributor(context(scope: scriptScope())) {

  delegateTo 'javasabr.mqtt.service.acl.AclBuilder'

  property name: 'ALLOW', type: 'javasabr.mqtt.model.acl.Permission'
  property name: 'DENY', type: 'javasabr.mqtt.model.acl.Permission'
  property name: 'PUBLISH', type: 'javasabr.mqtt.model.acl.Action'
  property name: 'SUBSCRIBE', type: 'javasabr.mqtt.model.acl.Action'
  property name: 'ALL', type: 'javasabr.mqtt.model.acl.Action'
  property name: 'OR', type: 'javasabr.mqtt.model.acl.Operator'
  property name: 'AND', type: 'javasabr.mqtt.model.acl.Operator'

  method name: 'rule',
      type: 'javasabr.mqtt.service.acl.AclBuilder',
      params: [ name: String, config: Closure ],
      doc: 'Define a rule'
  method name: 'permission',
      type: 'javasabr.mqtt.service.acl.AclBuilder.RuleBlock',
      params: [ string: 'javasabr.mqtt.model.acl.Permission' ],
      doc: 'Applied if the rule is successfully hit'
  method name: 'action',
      type: 'javasabr.mqtt.service.acl.AclBuilder.RuleBlock',
      params: [ string: 'javasabr.mqtt.model.acl.Action' ],
      doc: 'Type of MQTT event this rule applies to'
  method name: 'topics',
      type: 'javasabr.mqtt.service.acl.AclBuilder.RuleBlock',
      params: [ string: 'java.lang.String...' ]
  method name: 'clients',
      type: 'javasabr.mqtt.service.acl.AclBuilder.RuleBlock',
      params: [ config: 'groovy.lang.Closure' ]

  method name: 'operator',
      type: 'javasabr.mqtt.service.acl.AclBuilder.ClientsBlock',
      params: [ string: 'javasabr.mqtt.model.acl.Operator' ],
      doc: 'Conjunction or disjunction of client expressions. Default: OR'
  method name: 'username',
      type: 'javasabr.mqtt.service.acl.AclBuilder.ClientsBlock',
      params: [ string: 'java.lang.String...' ]
  method name: 'clientId',
      type: 'javasabr.mqtt.service.acl.AclBuilder.ClientsBlock',
      params: [ string: 'java.lang.String...' ]
  method name: 'clientAttr',
      type: 'javasabr.mqtt.service.acl.AclBuilder.ClientsBlock',
      params: [ string: 'java.lang.String...' ]
  method name: 'ipaddr',
      type: 'javasabr.mqtt.service.acl.AclBuilder.ClientsBlock',
      params: [ string: 'java.lang.String...' ]
}
